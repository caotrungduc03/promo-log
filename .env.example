# Frontend (Vite) - URL của Cloudflare Worker sau khi deploy (không lộ link Sheet)
VITE_SYNC_WORKER_URL="https://pomoday-sheet-sync.your-name.workers.dev"

# Cloudflare Worker Secrets (dùng `pnpm --dir worker secrets:push` để đẩy lên Cloudflare)
GOOGLE_CLIENT_EMAIL="sheets-worker@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="your-google-spreadsheet-id"
SYNC_SECRET="your-custom-sync-secret"
